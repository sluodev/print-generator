# 统一行尾与二进制标记
* text=auto

# 源码/配置/文档统一使用 LF
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.vue  text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.json5 text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.svg  text eol=lf
*.txt  text eol=lf
*.env  text eol=lf
*.sh   text eol=lf
*.ps1  text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

