{
  "name": "print-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Printable puzzle generators (Queens / One-Stroke / ...).",
  "homepage": "https://sluodev.github.io/print-generator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sluodev/print-generator.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier -w .",
    "format:check": "prettier -c ."
  },
  "dependencies": {
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
